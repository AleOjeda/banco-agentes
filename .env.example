# Variables para docker-compose (MySQL)
MYSQL_ROOT_PASSWORD=changeme_root
MYSQL_DATABASE=banco_agentes
MYSQL_USER=banco_agentes_user
MYSQL_PASSWORD=changeme_password

# Puerto expuesto por MySQL en el host (docker-compose)
DB_HOST_PORT=3306

# Variables de conexión que usará el backend (Sequelize)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=banco_agentes
DB_NAME_TEST=banco_agentes_test
DB_USER=banco_agentes_user
DB_PASSWORD=changeme_password

# Backend
PORT=3001

# CORS: origen permitido del frontend en desarrollo
CORS_ORIGIN=http://localhost:5173
